    {
      "type": "timeseries",
      "title": "Memory",
      "description": "",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${datasource}"
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
