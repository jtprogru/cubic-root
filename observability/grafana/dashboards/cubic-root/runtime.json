{
  "title": "cubic-root · Runtime and saturation",
  "uid": "cubic-root-runtime",
  "description": "Go runtime and process: CPU and scheduler saturation, memory and GC, concurrency, scraping.",
  "tags": [
    "cubic-root",
    "runtime"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "links": [
    {
      "title": "cubic-root",
      "type": "dashboards",
      "tags": [
        "cubic-root"
      ],
      "asDropdown": false,
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "vmalert",
      "type": "link",
      "url": "http://localhost:8880",
      "targetBlank": true,
      "icon": "bolt"
    },
    {
      "title": "VictoriaLogs UI",
      "type": "link",
      "url": "http://localhost:9428/select/vmui",
      "targetBlank": true,
      "icon": "doc"
    },
    {
      "title": "VictoriaTraces UI",
      "type": "link",
      "url": "http://localhost:10428/select/vmui",
      "targetBlank": true,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Metrics",
        "type": "datasource",
        "query": "victoriametrics-metrics-datasource",
        "hide": 0,
        "current": {}
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(cubic_root_build_info, job)",
          "refId": "job"
        },
        "definition": "label_values(cubic_root_build_info, job)",
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "current": {}
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Deploys",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "blue",
        "expr": "changes(process_start_time_seconds{job=\"$job\"}[2m]) > 0",
        "titleFormat": "restart / deploy",
        "step": "60s"
      },
      {
        "name": "Fault injection",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "orange",
        "expr": "max(cubic_root_fault_injection_enabled{job=\"$job\"}) == 1",
        "titleFormat": "fault injection is ON",
        "step": "60s"
      },
      {
        "name": "Alerts",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{alertstate=\"firing\", severity=~\"critical|warning\"}",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{severity}}",
        "step": "60s"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Saturation",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "CPU",
      "description": "CPU used as a share of GOMAXPROCS. Since Go 1.25 GOMAXPROCS follows the cgroup CPU limit.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${datasource}"
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": 60000
          },
          "links": [],
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "used, cores"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(process_cpu_seconds_total{job=\"$job\"}[$__rate_interval])) / sum(go_sched_gomaxprocs_threads{job=\"$job\"})",
          "legendFormat": "share of GOMAXPROCS",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(process_cpu_seconds_total{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "used, cores",
          "refId": "B"
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "heatmap",
      "title": "Scheduler latency",
      "description": "How long runnable goroutines wait for a thread. Moves up when the process is CPU-bound.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${datasource}"
      },
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Oranges",
          "steps": 64,
          "exponent": 0.5,
          "fill": "dark-orange",
          "reverse": false
        },
        "rowsFrame": {
          "layout": "le"
        },
        "yAxis": {
          "axisPlacement": "left",
          "unit": "s"
        },
        "tooltip": {
          "mode": "single",
          "yHistogram": true,
          "showColorScale": false
        },
        "legend": {
          "show": false
        },
        "filterValues": {
          "le": 1e-09
        }
      },
      "fieldConfig": {
        "defaults": {
          "links": []
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "sum by (le) (rate(go_sched_latencies_seconds_bucket{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{le}}",
          "format": "heatmap",
          "refId": "A"
        }
      ],
      "id": 3,
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "In-flight requests",
      "description": "",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${datasource}"
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": 60000
          },
          "links": [],
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "sum by (http_request_method) (http_server_active_requests{job=\"$job\"})",
          "legendFormat": "{{http_request_method}}",
          "refId": "A"
        }
      ],
      "id": 4,
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 5,
      "type": "row",
      "title": "Memory and GC",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Memory",
      "description": "",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${datasource}"
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": 60000
          },
          "links": [],
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "sum(process_resident_memory_bytes{job=\"$job\"})",
          "legendFormat": "RSS",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "sum(go_memstats_heap_inuse_bytes{job=\"$job\"})",
          "legendFormat": "heap in use",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "sum(go_gc_gomemlimit_bytes{job=\"$job\"} < 1e15)",
          "legendFormat": "GOMEMLIMIT",
          "refId": "C"
        }
      ],
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "GC share of CPU",
      "description": "",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${datasource}"
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": 60000
          },
          "links": [],
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(go_cpu_classes_gc_total_cpu_seconds_total{job=\"$job\"}[$__rate_interval])) / sum(rate(go_cpu_classes_total_cpu_seconds_total{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "gc",
          "refId": "A"
        }
      ],
      "id": 7,
      "gridPos": {
        "x": 8,
        "y": 10,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "GC cycles and pauses",
      "description": "",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${datasource}"
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": 60000
          },
          "links": [],
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "max pause"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(go_gc_duration_seconds_count{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "cycles/s",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "max(go_gc_duration_seconds{job=\"$job\", quantile=\"1\"})",
          "legendFormat": "max pause",
          "refId": "B"
        }
      ],
      "id": 8,
      "gridPos": {
        "x": 16,
        "y": 10,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "Concurrency and process",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Goroutines and threads",
      "description": "",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${datasource}"
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": 60000
          },
          "links": [],
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "sum(go_goroutines{job=\"$job\"})",
          "legendFormat": "goroutines",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "sum(go_threads{job=\"$job\"})",
          "legendFormat": "threads",
          "refId": "B"
        }
      ],
      "id": 10,
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Mutex wait",
      "description": "Seconds per second spent waiting on sync.Mutex / RWMutex.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${datasource}"
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": 60000
          },
          "links": [
            {
              "title": "Cache",
              "url": "/d/cubic-root-cache?${__url_time_range}&var-job=${job}"
            }
          ],
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(go_sync_mutex_wait_total_seconds_total{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "wait",
          "refId": "A"
        }
      ],
      "id": 11,
      "gridPos": {
        "x": 8,
        "y": 19,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "File descriptors",
      "description": "Open descriptors grow with connections; the limit is on the right axis.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${datasource}"
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": 60000
          },
          "links": [],
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "limit"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "sum(process_open_fds{job=\"$job\"})",
          "legendFormat": "open",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "sum(process_max_fds{job=\"$job\"})",
          "legendFormat": "limit",
          "refId": "B"
        }
      ],
      "id": 12,
      "gridPos": {
        "x": 16,
        "y": 19,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 13,
      "type": "row",
      "title": "Scrape",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Scrape duration and samples",
      "description": "How expensive /metrics is: grows with the number of series.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${datasource}"
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": 60000
          },
          "links": [],
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "samples"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "max(scrape_duration_seconds{job=\"$job\"})",
          "legendFormat": "duration",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "max(scrape_samples_scraped{job=\"$job\"})",
          "legendFormat": "samples",
          "refId": "B"
        }
      ],
      "id": 14,
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 7
      }
    },
    {
      "type": "stat",
      "title": "Series exposed",
      "description": "Samples per scrape of /metrics.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${datasource}"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "links": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "max(scrape_samples_scraped{job=\"$job\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 15,
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 6,
        "h": 7
      }
    },
    {
      "type": "stat",
      "title": "Target up",
      "description": "",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${datasource}"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "links": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN"
                },
                "1": {
                  "text": "UP"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "min(up{job=\"$job\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 16,
      "gridPos": {
        "x": 18,
        "y": 28,
        "w": 6,
        "h": 7
      }
    }
  ]
}
