            "uid": "victorialogs"
          },
          "expr": "{service=\"cubic-root\"} level:~\"${level:regex}\" trace_id:~\"${trace_id}\" _msg:~\"${search:regex}\" cache:* | stats by (cache) count()",
          "queryType": "stats",
          "editorMode": "code",
          "legendFormat": "{{cache}}",
