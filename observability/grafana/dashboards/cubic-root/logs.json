    {
      "id": 15,
      "type": "row",
      "title": "Pipeline: app → Vector → VictoriaLogs",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Vector events",
      "description": "Events per second at both ends of the Vector pipeline. They should match.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${datasource}"
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
