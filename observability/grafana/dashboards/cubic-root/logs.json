        "w": 6,
        "h": 9
      }
    },
    {
      "type": "logs",
      "title": "Errors and warnings",
      "description": "Click a line and use the TraceID link to open its trace.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
