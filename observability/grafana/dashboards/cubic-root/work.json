{
  "title": "cubic-root · Work and correctness",
  "uid": "cubic-root-work",
  "description": "What the service computes: outcomes, cost in Newton steps, accuracy and the input profile.",
  "tags": [
    "cubic-root",
    "work"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "links": [
    {
      "title": "cubic-root",
      "type": "dashboards",
      "tags": [
        "cubic-root"
      ],
      "asDropdown": false,
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "vmalert",
      "type": "link",
      "url": "http://localhost:8880",
      "targetBlank": true,
      "icon": "bolt"
    },
    {
      "title": "VictoriaLogs UI",
      "type": "link",
      "url": "http://localhost:9428/select/vmui",
      "targetBlank": true,
      "icon": "doc"
    },
    {
      "title": "VictoriaTraces UI",
      "type": "link",
      "url": "http://localhost:10428/select/vmui",
      "targetBlank": true,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Metrics",
        "type": "datasource",
        "query": "victoriametrics-metrics-datasource",
        "hide": 0,
        "current": {}
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(cubic_root_build_info, job)",
          "refId": "job"
        },
        "definition": "label_values(cubic_root_build_info, job)",
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "current": {}
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Deploys",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "blue",
        "expr": "changes(process_start_time_seconds{job=\"$job\"}[2m]) > 0",
        "titleFormat": "restart / deploy",
        "step": "60s"
      },
      {
        "name": "Fault injection",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "orange",
        "expr": "max(cubic_root_fault_injection_enabled{job=\"$job\"}) == 1",
        "titleFormat": "fault injection is ON",
        "step": "60s"
      },
      {
        "name": "Alerts",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{alertstate=\"firing\", severity=~\"critical|warning\"}",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{severity}}",
        "step": "60s"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "What the service computes",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Calculations",
      "description": "Computations actually performed (cache hits are not counted).",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${datasource}"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "links": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(cubic_root_calculations_total{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Bad results",
      "description": "Share of computations that did not converge, answered with 500.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${datasource}"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "links": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.0001
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(cubic_root_calculations_total{job=\"$job\", outcome=~\"max_iter|degenerate\"}[$__rate_interval])) / sum(rate(cubic_root_calculations_total{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 3,
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Steps per calculation",
      "description": "Average Newton steps per computation.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${datasource}"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "links": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(cubic_root_newton_iterations_sum{job=\"$job\"}[$__rate_interval])) / sum(rate(cubic_root_newton_iterations_count{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 4,
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Correct results",
      "description": "Correctness SLI: relative error |z³−d|/|d| ≤ 1e-12.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${datasource}"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "links": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.999
              },
              {
                "color": "green",
                "value": 0.9999
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 3
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(cubic_root_result_relative_error_bucket{job=\"$job\", le=\"1e-12\"}[$__rate_interval])) / sum(rate(cubic_root_result_relative_error_count{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Validation errors",
      "description": "Rejected inputs per second (the 4xx of /cubic-root).",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${datasource}"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "links": [
            {
              "title": "Logs",
              "url": "/d/cubic-root-logs?${__url_time_range}&var-job=${job}"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(cubic_root_validation_errors_total{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 6,
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Computation p99 (spans)",
      "description": "Duration of cubeRoot.calculate spans, CALC_DELAY included.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victoriatraces-logsql"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ns",
          "links": [
            {
              "title": "Traces",
              "url": "/d/cubic-root-traces?${__url_time_range}&var-job=${job}"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victoriatraces-logsql"
          },
          "expr": "name:\"cubeRoot.calculate\" | stats quantile(0.99, duration)",
          "queryType": "statsRange",
          "editorMode": "code",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 7,
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "timeseries",
      "title": "Calculations by outcome",
      "description": "converged; max_iter: iteration cap hit; degenerate: non-finite input; trivial: d = 0.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${datasource}"
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 40,
            "showPoints": "never",
            "spanNulls": 60000,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "links": [],
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "converged"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "max_iter"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "degenerate"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "trivial"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "gray"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "sum by (outcome) (rate(cubic_root_calculations_total{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Validation errors by reason",
      "description": "",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${datasource}"
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 40,
            "showPoints": "never",
            "spanNulls": 60000,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "links": [],
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "sum by (reason) (rate(cubic_root_validation_errors_total{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "id": 9,
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "heatmap",
      "title": "Newton steps",
      "description": "Steps per computation. After the fix of the algorithm it is 3–5 for any input.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${datasource}"
      },
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Oranges",
          "steps": 64,
          "exponent": 0.5,
          "fill": "dark-orange",
          "reverse": false
        },
        "rowsFrame": {
          "layout": "le"
        },
        "yAxis": {
          "axisPlacement": "left",
          "unit": "short"
        },
        "tooltip": {
          "mode": "single",
          "yHistogram": true,
          "showColorScale": false
        },
        "legend": {
          "show": false
        },
        "filterValues": {
          "le": 1e-09
        }
      },
      "fieldConfig": {
        "defaults": {
          "links": []
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "sum by (le) (rate(cubic_root_newton_iterations_bucket{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{le}}",
          "format": "heatmap",
          "refId": "A"
        }
      ],
      "id": 10,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "heatmap",
      "title": "Relative error |z³−d|/|d|",
      "description": "Accuracy of results. Errors ≥ 100% are recorded as 1 and land in +Inf.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${datasource}"
      },
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Reds",
          "steps": 64,
          "exponent": 0.5,
          "fill": "dark-orange",
          "reverse": false
        },
        "rowsFrame": {
          "layout": "le"
        },
        "yAxis": {
          "axisPlacement": "left",
          "unit": "short"
        },
        "tooltip": {
          "mode": "single",
          "yHistogram": true,
          "showColorScale": false
        },
        "legend": {
          "show": false
        },
        "filterValues": {
          "le": 1e-09
        }
      },
      "fieldConfig": {
        "defaults": {
          "links": []
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "sum by (le) (rate(cubic_root_result_relative_error_bucket{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{le}}",
          "format": "heatmap",
          "refId": "A"
        }
      ],
      "id": 11,
      "gridPos": {
        "x": 8,
        "y": 13,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "heatmap",
      "title": "Input order of magnitude log10|d|",
      "description": "Workload profile: which inputs clients send.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${datasource}"
      },
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Blues",
          "steps": 64,
          "exponent": 0.5,
          "fill": "dark-orange",
          "reverse": false
        },
        "rowsFrame": {
          "layout": "le"
        },
        "yAxis": {
          "axisPlacement": "left",
          "unit": "short"
        },
        "tooltip": {
          "mode": "single",
          "yHistogram": true,
          "showColorScale": false
        },
        "legend": {
          "show": false
        },
        "filterValues": {
          "le": 1e-09
        }
      },
      "fieldConfig": {
        "defaults": {
          "links": []
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "sum by (le) (rate(cubic_root_input_magnitude_log10_bucket{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{le}}",
          "format": "heatmap",
          "refId": "A"
        }
      ],
      "id": 12,
      "gridPos": {
        "x": 16,
        "y": 13,
        "w": 8,
        "h": 8
      }
    }
  ]
}
