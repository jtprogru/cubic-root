{
  "title": "cubic-root · Cache",
  "uid": "cubic-root-cache",
  "description": "Drill-down into the response cache: effectiveness, sizing (ghost list, TTL) and cost.",
  "tags": [
    "cubic-root",
    "cache"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "links": [
    {
      "title": "cubic-root",
      "type": "dashboards",
      "tags": [
        "cubic-root"
      ],
      "asDropdown": false,
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "vmalert",
      "type": "link",
      "url": "http://localhost:8880",
      "targetBlank": true,
      "icon": "bolt"
    },
    {
      "title": "VictoriaLogs UI",
      "type": "link",
      "url": "http://localhost:9428/select/vmui",
      "targetBlank": true,
      "icon": "doc"
    },
    {
      "title": "VictoriaTraces UI",
      "type": "link",
      "url": "http://localhost:10428/select/vmui",
      "targetBlank": true,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Metrics",
        "type": "datasource",
        "query": "victoriametrics-metrics-datasource",
        "hide": 0,
        "current": {}
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(cubic_root_build_info, job)",
          "refId": "job"
        },
        "definition": "label_values(cubic_root_build_info, job)",
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "current": {}
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Deploys",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "blue",
        "expr": "changes(process_start_time_seconds{job=\"$job\"}[2m]) > 0",
        "titleFormat": "restart / deploy",
        "step": "60s"
      },
      {
        "name": "Fault injection",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "orange",
        "expr": "max(cubic_root_fault_injection_enabled{job=\"$job\"}) == 1",
        "titleFormat": "fault injection is ON",
        "step": "60s"
      },
      {
        "name": "Alerts",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{alertstate=\"firing\", severity=~\"critical|warning\"}",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{severity}}",
        "step": "60s"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Does it work",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Hit ratio",
      "description": "Server-side share of lookups served from the cache.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${datasource}"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "links": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 0.8
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(cubic_root_cache_requests_total{job=\"$job\", result=\"hit\"}[$__rate_interval])) / sum(rate(cubic_root_cache_requests_total{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 5
      }
    },
    {
      "type": "stat",
      "title": "Hit ratio seen by k6",
      "description": "Share of X-Cache: HIT responses reported by the latest k6 run in the time range; should match the server side.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${datasource}"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "links": [
            {
              "title": "Load test",
              "url": "/d/cubic-root-loadtest?${__url_time_range}&var-job=${job}"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "max(k6_cache_hits_rate)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 3,
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 5
      }
    },
    {
      "type": "stat",
      "title": "Computations per request",
      "description": "1 without a cache; 1 − hit ratio with it.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${datasource}"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "links": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(cubic_root_calculations_total{job=\"$job\"}[$__rate_interval])) / sum(rate(http_server_request_duration_seconds_count{job=\"$job\", http_route=\"/cubic-root\", http_response_status_code=\"200\"}[$__rate_interval]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 4,
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 5
      }
    },
    {
      "type": "stat",
      "title": "Work saved",
      "description": "Newton steps per second not computed thanks to hits.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${datasource}"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "links": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(cubic_root_cache_requests_total{job=\"$job\", result=\"hit\"}[$__rate_interval])) * sum(rate(cubic_root_newton_iterations_sum{job=\"$job\"}[$__rate_interval])) / sum(rate(cubic_root_newton_iterations_count{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 5
      }
    },
    {
      "type": "stat",
      "title": "Coalesced",
      "description": "Misses that waited for a computation already started by another request (singleflight).",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${datasource}"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "links": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(cubic_root_cache_coalesced_total{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 6,
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 5
      }
    },
    {
      "type": "stat",
      "title": "TTL",
      "description": "CACHE_TTL; 0 means no expiry or no cache.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${datasource}"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "links": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "max(cubic_root_cache_ttl_seconds{job=\"$job\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 7,
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 5
      }
    },
    {
      "type": "timeseries",
      "title": "Lookups",
      "description": "",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${datasource}"
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": 60000
          },
          "links": [],
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "sum by (result) (rate(cubic_root_cache_requests_total{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(cubic_root_cache_coalesced_total{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "coalesced",
          "refId": "B"
        }
      ],
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Latency of HIT vs MISS (from spans)",
      "description": "Server span duration by cache status. The gap is what a hit saves; without CALC_DELAY it is tiny.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victoriatraces-logsql"
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ns",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": 60000
          },
          "links": [
            {
              "title": "Traces",
              "url": "/d/cubic-root-traces?${__url_time_range}&var-job=${job}"
            }
          ],
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victoriatraces-logsql"
          },
          "expr": "\"resource_attr:service.name\":\"cubic-root\" kind:2 \"span_attr:http.route\":\"/cubic-root\" \"span_attr:cache.status\":* | rename \"span_attr:cache.status\" as cache_status | stats by (cache_status) quantile(0.5, duration) p50, quantile(0.99, duration) p99",
          "queryType": "statsRange",
          "editorMode": "code",
          "legendFormat": "{{cache_status}} {{__name__}}",
          "refId": "A"
        }
      ],
      "id": 9,
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Is it the right size",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Fill",
      "description": "",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${datasource}"
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": 60000
          },
          "links": [],
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "sum(cubic_root_cache_entries{job=\"$job\"})",
          "legendFormat": "entries",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "sum(cubic_root_cache_capacity_entries{job=\"$job\"})",
          "legendFormat": "capacity",
          "refId": "B"
        }
      ],
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 6,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Evictions by reason",
      "description": "capacity: the cache is too small; expired: TTL is too short.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${datasource}"
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 40,
            "showPoints": "never",
            "spanNulls": 60000,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "links": [],
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "sum by (reason) (rate(cubic_root_cache_evictions_total{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "id": 12,
      "gridPos": {
        "x": 6,
        "y": 15,
        "w": 6,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Hit ratio now vs with 2× capacity",
      "description": "The ghost list remembers keys evicted for capacity: a miss on one of them is a hit a cache twice as large would have served. A small gap means a bigger cache will not help.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${datasource}"
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": 60000
          },
          "links": [],
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(cubic_root_cache_requests_total{job=\"$job\", result=\"hit\"}[$__rate_interval])) / sum(rate(cubic_root_cache_requests_total{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "now",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "(sum(rate(cubic_root_cache_requests_total{job=\"$job\", result=\"hit\"}[$__rate_interval])) + sum(rate(cubic_root_cache_ghost_hits_total{job=\"$job\"}[$__rate_interval]))) / sum(rate(cubic_root_cache_requests_total{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "with 2× CACHE_SIZE",
          "refId": "B"
        }
      ],
      "id": 13,
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Entry age at hit vs TTL",
      "description": "If hits keep happening right up to the TTL, a longer TTL would add more hits.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${datasource}"
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": 60000
          },
          "links": [],
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(cubic_root_cache_hit_age_seconds_bucket{job=\"$job\"}[$__rate_interval])))",
          "legendFormat": "p50 age",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(cubic_root_cache_hit_age_seconds_bucket{job=\"$job\"}[$__rate_interval])))",
          "legendFormat": "p99 age",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "expr": "max(cubic_root_cache_ttl_seconds{job=\"$job\"})",
          "legendFormat": "TTL",
          "refId": "C"
        }
      ],
      "id": 14,
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "heatmap",
      "title": "Entry age at hit",
      "description": "",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${datasource}"
      },
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Greens",
          "steps": 64,
          "exponent": 0.5,
          "fill": "dark-orange",
          "reverse": false
        },
        "rowsFrame": {
          "layout": "le"
        },
        "yAxis": {
          "axisPlacement": "left",
          "unit": "s"
        },
        "tooltip": {
          "mode": "single",
          "yHistogram": true,
          "showColorScale": false
        },
        "legend": {
          "show": false
        },
        "filterValues": {
          "le": 1e-09
        }
      },
      "fieldConfig": {
        "defaults": {
          "links": []
        },
        "overrides": []
